    {
      "cell_type": "code",
      "execution_count": 46,
      "id": "NIeHY9y1LroF",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 1000
        },
        "id": "NIeHY9y1LroF",
        "outputId": "066db35b-d531-4a77-d3fb-233a4a3b1b8f"
      },
      "outputs": [
        {
          "data": {
            "image/png": "",
            "text/plain": [
              "<Figure size 1900x1400 with 1 Axes>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
