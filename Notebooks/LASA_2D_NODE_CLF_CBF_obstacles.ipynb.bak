      "source": [
        "Model parameters:\n",
        "\n",
        "Line:\n",
        "\n",
        "lr_strategy=(3e-3,),\n",
        "steps_strategy=(5000,),\n",
        "length_strategy=(1,),\n",
        "width_size=32,\n",
        "depth=3,\n",
        "\n",
        "Saeghe:\n",
        "\n",
        "lr_strategy=(3e-4,),\n",
        "steps_strategy=(8000,),\n",
        "length_strategy=(1,),\n",
        "width_size=128,\n",
        "depth=3,\n",
        "\n",
        "BendedLine(okayish), Zshape, Worm:\n",
        "\n",
        "lr_strategy=(4e-4,),\n",
