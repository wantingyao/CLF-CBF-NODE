   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10, 8))\n",
    "\n",
    "ax.plot(xref[:, 0], xref[:, 1], label='target', color='green')\n",
    "ax.plot(xall[:, 0], xall[:, 1], label='path', color='red')\n",
    "\n",
    "# ---- Ellipse parameters ----\n",
    "center1 = (-27, -7)\n",
    "a1, b1, angle1 = 5, 7, 0\n",
    "\n",
    "center2 = (-25, -15)\n",
    "a2, b2, angle2 = 6, 3.5, -np.pi/7\n",
    "\n",
    "theta = np.linspace(0, 2*np.pi, 200)\n",
    "\n",
    "x1 = center1[0] + a1*np.cos(theta)*np.cos(angle1) - b1*np.sin(theta)*np.sin(angle1)\n",
    "y1 = center1[1] + a1*np.cos(theta)*np.sin(angle1) + b1*np.sin(theta)*np.cos(angle1)\n",
    "\n",
    "x2 = center2[0] + a2*np.cos(theta)*np.cos(angle2) - b2*np.sin(theta)*np.sin(angle2)\n",
    "y2 = center2[1] + a2*np.cos(theta)*np.sin(angle2) + b2*np.sin(theta)*np.cos(angle2)\n",
    "\n",
    "ax.plot(x1, y1, label='Ellipse 1')\n",
    "ax.plot(x2, y2, label='Ellipse 2')\n",
    "\n",
    "# ---- formatting ----\n",
    "ax.set_xlabel('X-axis', fontsize=14, labelpad=6)\n",
    "ax.set_ylabel('Y-axis', fontsize=14, labelpad=6)\n",
    "ax.tick_params(labelsize=12)\n",
    "\n",
    "fig.tight_layout(pad=1.5)\n",
    "plt.show()\n"
   ]
  },
