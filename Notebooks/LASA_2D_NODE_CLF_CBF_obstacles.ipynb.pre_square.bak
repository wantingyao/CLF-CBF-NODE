    "ndemos = len(demos)\n",
    "T = demos[0].t.shape[-1]\n",
    "pos_all = []\n",
    "vel_all = []\n",
    "for i in range(ndemos):\n",
    "  pos_all.append((demos[i].pos).T)\n",
    "  vel_all.append((demos[i].vel).T)\n",
    "posn = jnp.array(pos_all)\n",
    "veln = jnp.array(vel_all)\n",
    "tn =  jnp.array(t.T).reshape(T)\n",
    "ys_all_n = jnp.concatenate((posn,veln),axis=2)"
   ]
  },
