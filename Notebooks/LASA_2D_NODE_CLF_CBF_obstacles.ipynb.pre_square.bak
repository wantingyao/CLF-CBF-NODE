    "# pos_x, pos_y, xc1, yc1, a1, b1, angle1, xc2, yc2, a2, b2, angle2 = sym.symbols('pos_x pos_y xc1 yc1 a1 b1 angle1 xc2 yc2 a2 b2 angle2')\n",
