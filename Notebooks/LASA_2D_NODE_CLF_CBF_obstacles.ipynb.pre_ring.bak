    "# ymax = 30\n",
    "\n",
    "indx = train_indx\n",
    "\n",
    "f = lambda z : model.func(_, z, _)\n",
    "\n",
    "(fig, ax) = plt.subplots(nrows=1, ncols=1, figsize=(19,14))\n",
